{
  "name": "htmlto-link-md",
  "displayName": "%displayName%",
  "description": "%description%",
  "icon": "media/icon.png",
  "version": "0.1.12",
  "license": "MIT",
  "publisher": "licc",
  "repository": {
    "type": "git",
    "url": "https://github.com/licc168/htmlto-link-md-vscode.git"
  },
  "homepage": "https://github.com/licc168/htmlto-link-md-vscode#readme",
  "bugs": {
    "url": "https://github.com/licc168/htmlto-link-md-vscode/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "md",
    "share",
    "publish",
    "preview",
    "htmlto.link",
    "markdown share",
    "md to web",
    "markdown publish",
    "文档分享",
    "Markdown分享",
    "一键分享",
    "文档转网页",
    "Markdown发布",
    "笔记分享"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "htmlToLinkMd.share",
        "title": "%command.share%",
        "category": "%commandCategory%",
        "icon": "$(globe)"
      },
      {
        "command": "htmlToLinkMd.deleteShare",
        "title": "%command.deleteShare%",
        "category": "%commandCategory%"
      },
      {
        "command": "htmlToLinkMd.setToken",
        "title": "%command.setToken%",
        "category": "%commandCategory%"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceLangId == markdown",
          "command": "htmlToLinkMd.share",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceLangId == markdown",
          "command": "htmlToLinkMd.share",
          "group": "htmlToLink@1"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "htmlToLinkMd.apiBaseUrl": {
          "type": "string",
          "default": "https://htmlto.link",
          "description": "%config.apiBaseUrl%"
        },
        "htmlToLinkMd.defaultTemplate": {
          "type": "string",
          "default": "plain",
          "description": "%config.defaultTemplate%"
        },
        "htmlToLinkMd.autoCopyUrl": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoCopyUrl%"
        },
        "htmlToLinkMd.openInBrowser": {
          "type": "boolean",
          "default": false,
          "description": "%config.openInBrowser%"
        },
        "htmlToLinkMd.uploadLocalImages": {
          "type": "boolean",
          "default": true,
          "description": "Automatically upload local images referenced in Markdown to htmlto.link asset service"
        },
        "htmlToLinkMd.enableTelemetry": {
          "type": "boolean",
          "default": false,
          "description": "%config.enableTelemetry%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && npm run bundle:mermaid",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext .ts",
    "bundle:mermaid": "node scripts/bundle-mermaid.mjs",
    "sync:templates": "node scripts/sync-template-assets.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.5",
    "eslint": "^9.39.5",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.68.0"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "marked": "^18.0.5",
    "mermaid": "^11.17.2"
  }
}
