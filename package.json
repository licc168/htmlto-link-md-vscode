{
  "name": "htmlto-link-md",
  "displayName": "%displayName%",
  "description": "%description%",
  "icon": "media/icon.png",
  "version": "0.1.1",
  "license": "MIT",
  "publisher": "licc",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "md",
    "share",
    "publish",
    "preview",
    "htmlto.link",
    "markdown share",
    "md to web",
    "markdown publish",
    "文档分享",
    "Markdown分享",
    "一键分享",
    "文档转网页",
    "Markdown发布",
    "笔记分享"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "htmlToLinkMd.share",
        "title": "%command.share%",
        "category": "%commandCategory%",
        "icon": "$(globe)"
      },
      {
        "command": "htmlToLinkMd.deleteShare",
        "title": "%command.deleteShare%",
        "category": "%commandCategory%"
      },
      {
        "command": "htmlToLinkMd.setToken",
        "title": "%command.setToken%",
        "category": "%commandCategory%"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceLangId == markdown",
          "command": "htmlToLinkMd.share",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceLangId == markdown",
          "command": "htmlToLinkMd.share",
          "group": "htmlToLink@1"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "htmlToLinkMd.apiBaseUrl": {
          "type": "string",
          "default": "https://htmlto.link",
          "description": "%config.apiBaseUrl%"
        },
        "htmlToLinkMd.defaultTemplate": {
          "type": "string",
          "default": "plain",
          "description": "%config.defaultTemplate%"
        },
        "htmlToLinkMd.autoCopyUrl": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoCopyUrl%"
        },
        "htmlToLinkMd.openInBrowser": {
          "type": "boolean",
          "default": false,
          "description": "%config.openInBrowser%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.5.0"
  }
}
